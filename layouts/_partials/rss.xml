{{- $pages := first site.Config.Services.RSS.Limit (where site.RegularPages "Section" "posts").ByDate.Reverse -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <language>{{ site.Language.Locale }}</language>
    {{ with $pages }}<lastBuildDate>{{ (index . 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    <atom:link href="{{ "feed/" | absURL }}" rel="self" type="application/rss+xml" />
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- /* Feed readers know items by GUID. Migrated posts keep the GUID
      WordPress gave them, which does not change with baseURL. */}}
      {{ with .Params.wp_id }}<guid isPermaLink="false">https://stimhack.com/?p={{ . }}</guid>{{ else }}<guid>{{ .Permalink }}</guid>{{ end }}
      {{ with index (.GetTerms "authors") 0 }}<dc:creator xmlns:dc="http://purl.org/dc/elements/1.1/">{{ .Title }}</dc:creator>{{ end }}
      <description>{{ partial "summary-text.html" . | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>

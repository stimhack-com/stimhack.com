{{- /* The site feed lists all posts, a category feed the posts in that category. */}}
{{- $pages := where (cond .IsHome site.RegularPages .Pages) "Section" "posts" -}}
{{- /* Every feed leaves out posts in any category of feedExcludeCategories,
as the WordPress site feed and category feeds did: its decklists category
feed had no items. The pages of the category are the posts its archive
lists, also those whose front matter spells the category another way. */}}
{{- range site.Params.feedExcludeCategories }}
{{- with site.GetPage (printf "/categories/%s" .) }}{{ $pages = $pages | complement .Pages }}{{ end }}
{{- end }}
{{- $pages = first site.Config.Services.RSS.Limit $pages.ByDate.Reverse -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}{{ if not .IsHome }} » {{ .Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <language>{{ site.Language.Locale }}</language>
    {{ with $pages }}<lastBuildDate>{{ (index . 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    <atom:link href="{{ .Permalink }}feed/" rel="self" type="application/rss+xml" />
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- /* Feed readers know items by GUID, so posts from WordPress keep the
      GUID it stored for them (wp_guid, from guid in the export). It does not
      change with baseURL, and for older posts it starts with http:. */}}
      {{ with .Params.wp_guid }}<guid isPermaLink="false">{{ . }}</guid>{{ else }}<guid>{{ .Permalink }}</guid>{{ end }}
      {{ with index (.GetTerms "authors") 0 }}<dc:creator xmlns:dc="http://purl.org/dc/elements/1.1/">{{ .Title }}</dc:creator>{{ end }}
      <description>{{ partial "summary-text.html" . | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
